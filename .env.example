# Copy this file to `.env` and fill it in. `.env` is git-ignored, so your keys stay private.
# Docker Compose reads it automatically; the Django backend also loads it when run locally.

# --- Mistral AI (Codestral) ---------------------------------------------
# Leave the key empty to use the simple offline keyword matcher instead.
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-2508

# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
# Optional: key used to encrypt hidden candidate identities (see README to generate one)
PII_ENCRYPTION_KEY=
# Master key that locks the stored data keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it on Render. To rotate it, use "newkey,oldkey" then run `python manage.py rotate_keys`.
KEY_ENCRYPTION_KEY=

# --- Frontend --------------------------------------------------------------
# Where the website finds the API (your Render URL once deployed)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Which website addresses may call the API (your Vercel URL once deployed)
CORS_ALLOWED_ORIGINS=http://localhost:3000
